# Feature flag — bridge does nothing unless this is true
BRIDGE_ENABLED=false

# Shared trust token (server-to-server). Generate with:
#   openssl rand -hex 32
BRIDGE_TOKEN=replace_me

# Where each side lives
APP_PIPTRADER_URL=https://app.piptraderai.com
MAIN_PIPTRADER_URL=https://piptraderai.com

# Optional: port for the local test server
BRIDGE_TEST_PORT=8790
